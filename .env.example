# Supabase → Project Settings → API (ou Connect).
# Use SOMENTE a chave pública: "anon" (JWT) ou "publishable" (sb_publishable_...).
# NUNCA coloque a chave service_role / secret aqui: o site se recusa a iniciar com ela.
#
# Na Vercel, cadastre as duas variáveis para Production E Preview e faça um novo deploy:
# as variáveis VITE_* são embutidas no site na hora da compilação.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_KEY
